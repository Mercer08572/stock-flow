# Stock-Flow 后端配置示例
#
# 用法：
#   cp .env.example .env
#   然后按本机情况修改 DATABASE_URL
#
# 加载优先级（高 → 低）：
#   export 导出的环境变量  >  .env 文件  >  内置默认值
# 只要变量存在于环境中就一定生效，**空串也算已设置**；.env 只填补环境里完全没有的变量。
# 显式设置的空值会被原样应用，不会回落到内置默认值（字符串字段校验失败、数字/时长/布尔字段报解析错误）。
# 想使用内置默认值请 `unset FOO`，不要写 `export FOO=`；.env 里写 `FOO=` 与导出空值等效。
#
# .env 是可选的：生产与 CI 直接注入真实环境变量即可，没有 .env 也能启动。
# 但 ENV_FILE 显式指定的文件必须存在，否则启动失败。
# .env 按进程工作目录查找（默认 ./.env）；不从项目根目录启动时用 ENV_FILE 指定。
# .env 与 .env.* 均被 git 忽略，只有本模板会入库。

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_ENV=development
GIN_MODE=debug
HTTP_ADDR=:8181
SHUTDOWN_TIMEOUT=10s

# 可选：指定 dotenv 文件路径（默认 ./.env）
# ENV_FILE=/etc/stock-flow/.env

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 必需。此处仅为占位值，请勿写入真实凭据。
# 远端数据库必须启用 TLS：sslmode=require 或 verify-full。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_flow_dev?sslmode=disable

# 可选：HTTP_ADDR 的别名，仅在 HTTP_ADDR 未设置时生效。
# PORT=8181

# ---------------------------------------------------------------------------
# 管理员会话（cookie）
# ---------------------------------------------------------------------------
AUTH_ADMIN_SESSION_TTL=8h
AUTH_ADMIN_COOKIE_SAME_SITE=lax
# 生产环境必须为 true
AUTH_ADMIN_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# 管理员引导（仅 `stock-flow-admin init` 使用，不参与 API 服务启动）
# ---------------------------------------------------------------------------
# 迁移只会创建 username='admin' 的引导行，其 password_hash 不可登录；
# 真实口令必须由 `go run ./cmd/admin init`（交互式或 --password-stdin）写入。
# 该变量只是免交互注入口令的临时手段，写入后请立即清除，不要长期保留在环境中。
# ADMIN_INITIAL_PASSWORD=

# ---------------------------------------------------------------------------
# 登录失败限流
# ---------------------------------------------------------------------------
AUTH_LOGIN_FAILURE_MAX_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_LOCKOUT=15m
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
