# Stock-Flow 后端环境变量示例
#
# 复制为 .env 并按需填写（.env 已被 .gitignore 忽略，不会入库）：
#   cp .env.example .env
#
# 注意：本项目的 Go 代码**不会**自动读取 .env 文件，它只是集中记录变量名。
# 请通过 shell 导出，例如：
#   set -a && . ./.env && set +a
# 或在 CI / 部署平台的环境变量设置中逐条配置。
#
# 加载优先级：默认值 < 配置文件（configs/<APP_ENV>.yaml） < 环境变量

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
APP_ENV=development
GIN_MODE=debug
HTTP_ADDR=:8181
SHUTDOWN_TIMEOUT=10s

# 指定配置文件路径（优先级高于 configs/<APP_ENV>.yaml 的默认推导）
# CONFIG_FILE=configs/development.yaml

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 必需。此处仅为占位格式，禁止在此写入真实口令。
# 生产环境必须使用 sslmode=require（或 verify-full）。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stock_flow_dev?sslmode=disable

# ---------------------------------------------------------------------------
# 管理员会话（cookie）
# ---------------------------------------------------------------------------
AUTH_ADMIN_SESSION_TTL=8h
AUTH_ADMIN_COOKIE_SAME_SITE=lax
# 生产环境必须为 true
AUTH_ADMIN_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# 登录失败限流
# ---------------------------------------------------------------------------
AUTH_LOGIN_FAILURE_MAX_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_LOCKOUT=15m
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
